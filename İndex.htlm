<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beni Seviyor Musun?</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Poppins:wght@400;600&display=swap');

        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #ffafbd, #ffc3a0);
            font-family: 'Poppins', sans-serif;
            overflow: hidden;
            position: relative;
        }

        /* Arka plandaki uçuşan kalpler */
        .bg-heart {
            position: absolute;
            color: rgba(255, 75, 110, 0.4);
            font-size: 24px;
            animation: floatUp 6s linear infinite;
            bottom: -50px;
            z-index: 1;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(0) scale(1) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(-110vh) scale(1.3) rotate(360deg);
                opacity: 0;
            }
        }

        /* Ana Kart Tasarımı */
        .card {
            background: white;
            padding: 35px 40px;
            border-radius: 24px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            text-align: center;
            width: 380px;
            max-width: 90%;
            z-index: 10;
            transition: all 0.3s ease;
        }

        /* Kaliteli Parlama Efekti */
        .title {
            font-family: 'Caveat', cursive;
            font-size: 44px;
            color: #ff2a54;
            margin: 0 0 5px 0;
            animation: premiumGlow 2s ease-in-out infinite alternate;
        }

        @keyframes premiumGlow {
            0% {
                text-shadow: 0 0 5px rgba(255, 175, 189, 0.5), 
                             0 0 10px rgba(255, 75, 110, 0.3);
                transform: scale(1);
            }
            100% {
                text-shadow: 0 0 10px rgba(255, 255, 255, 0.8), 
                             0 0 20px rgba(255, 175, 189, 0.8), 
                             0 0 30px rgba(255, 75, 110, 0.6), 
                             0 0 40px rgba(255, 42, 84, 0.4);
                transform: scale(1.03);
            }
        }

        .question {
            font-family: 'Caveat', cursive;
            font-size: 28px;
            color: #555;
            margin: 0 0 20px 0;
        }

        /* Kedi ve Görsel Alanı */
        .image-container {
            height: 180px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 25px;
        }

        .image-container img {
            height: 100%;
            object-fit: contain;
        }

        /* Butonlar */
        .btn-container {
            display: flex;
            justify-content: center;
            gap: 20px;
        }

        .btn {
            padding: 12px 30px;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .btn-yes {
            background-color: #ff4b6e;
            color: white;
        }

        .btn-yes:hover {
            transform: scale(1.08);
            background-color: #ff2a54;
        }

        .btn-no {
            background-color: #f3f3f3;
            color: #666;
        }

        .btn-no:hover {
            background-color: #e5e5e5;
        }
    </style>
</head>
<body>

    <div id="heart-container"></div>

    <div class="card">
        <h1 class="title">Diclemm</h1>
        <p class="question">Beni seviyor musun?</p>
        
        <div class="image-container">
            <img id="cat-img" src="https://media.tenor.com/7gK_Tq0A_mUAAAAi/mochi-mochi-peach-cat-kiss.gif" alt="Öpücük Atan Kedi">
        </div>

        <div class="btn-container">
            <button class="btn btn-yes" onclick="selectYes()">Evet ❤️</button>
            <button class="btn btn-no" id="no-btn" onclick="selectNo()">Hayır</button>
        </div>
    </div>

    <script>
        function selectYes() {
            document.querySelector('.question').innerText = "Ben de seni çok seviyorum! 🌷";
            document.getElementById('cat-img').src = "https://images.unsplash.com/photo-1525310072745-f49212b5ac6d?q=80&w=500&auto=format&fit=crop"; 
            document.getElementById('cat-img').style.borderRadius = "12px";
            
            document.getElementById('no-btn').style.display = 'none';
            
            for(let i=0; i<30; i++) {
                setTimeout(createHeart, i * 100);
            }
        }

        function selectNo() {
            document.querySelector('.question').innerText = "Üzdün... 💔";
            document.getElementById('cat-img').src = "https://media.tenor.com/bKID4fUu6g4AAAAi/sad-cat.gif";
        }

        function createHeart() {
            const container = document.getElementById('heart-container');
            const heart = document.createElement('div');
            heart.classList.add('bg-heart');
            heart.innerHTML = '❤️';
            
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = Math.random() * 3 + 4 + 's'; 
            heart.style.fontSize = Math.random() * 20 + 15 + 'px';
            
            container.appendChild(heart);

            setTimeout(() => {
                heart.remove();
            }, 6000);
        }

        setInterval(createHeart, 500);
    </script>
</body>
</html>
